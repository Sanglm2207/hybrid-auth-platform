{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "local: env",
      "type": "process",
      "command": "bash",
      "args": [
        "./prepare-env.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "local: keys",
      "type": "process",
      "command": "bash",
      "args": [
        "./prepare-jwt.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "local: databases up",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "up",
        "-d",
        "--wait",
        "postgres",
        "redis"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "local: prepare",
      "dependsOrder": "sequence",
      "dependsOn": [
        "local: env",
        "local: keys",
        "local: databases up",
        "local: profile database"
      ],
      "problemMatcher": []
    },
    {
      "label": "local: databases stop",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "stop",
        "postgres",
        "redis"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "maven: verify",
      "type": "process",
      "command": "mvn",
      "args": [
        "-B",
        "-ntp",
        "verify"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$javac"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "maven: install shared modules",
      "type": "process",
      "command": "mvn",
      "args": [
        "-B",
        "-ntp",
        "-DskipTests",
        "-pl",
        "api-common,api-servlet,api-reactive",
        "-am",
        "install"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$javac"
      ]
    },
    {
      "label": "local: profile database",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "exec",
        "-T",
        "postgres",
        "psql",
        "-v",
        "ON_ERROR_STOP=1",
        "-U",
        "auth",
        "-d",
        "authdb",
        "-f",
        "/docker-entrypoint-initdb.d/01-user-db.sql"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
