<included>
  <appender name="SECURITY_AUDIT" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${AUDIT_LOG_PATH:-logs/security-audit}/${springAppName:-application}.jsonl</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${AUDIT_LOG_PATH:-logs/security-audit}/${springAppName:-application}.%d{yyyy-MM-dd}.%i.jsonl.gz</fileNamePattern>
      <maxFileSize>10MB</maxFileSize><maxHistory>90</maxHistory><totalSizeCap>1GB</totalSizeCap>
    </rollingPolicy>
    <encoder><pattern>%msg%n</pattern></encoder>
  </appender>
  <logger name="security.audit" level="INFO" additivity="false">
    <appender-ref ref="SECURITY_AUDIT"/><appender-ref ref="CONSOLE"/>
  </logger>
</included>
