# Local development settings. run-services.sh creates .env if missing.
# Keep this file compatible with Bash and Docker Compose.
DB_PASSWORD=authdev

# Internal Mail service (prepare-env.sh generates a shared key when empty)
MAIL_SERVICE_URL=http://127.0.0.1:8703
MAIL_SERVICE_PORT=8703
MAIL_SERVICE_API_KEY=

# SMTP configuration (used only by mail-service)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=""
MAIL_SIGNATURE="Hybrid Auth Security Team"

# Gateway-to-Auth client IP signatures (generated by prepare-env.sh when empty)
AUTH_PROXY_KEY=
# Private JWK manifest (prepare-jwt.sh initializes it from existing PEMs when empty)
JWT_KEY_SET=
LOGIN_IP_LIMIT=20
AUTH_IP_LIMIT=60
AUTH_RATE_WINDOW_SECONDS=60
LOGIN_FAILURE_THRESHOLD=5
LOGIN_OBSERVATION_SECONDS=900
LOGIN_LOCK_SECONDS=300

# Gateway hostnames and frontend origins (comma-separated exact values)
GATEWAY_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
GATEWAY_REQUIRE_ORIGIN=false
