# Local development settings. run-services.sh creates .env if missing.
# Keep this file compatible with Bash and Docker Compose.
DB_PASSWORD=authdev
AUTH_APP_PASSWORD=authappdev
AUTH_MIGRATION_PASSWORD=authmigrdev
PROFILE_APP_PASSWORD=profileappdev
MAIL_APP_PASSWORD=mailappdev
MAIL_MIGRATION_PASSWORD=mailmigrdev
MAIL_OUTBOX_ENCRYPTION_KEY=

# Internal Mail service (prepare-env.sh generates a shared key when empty)
MAIL_SERVICE_URL=http://127.0.0.1:8703
MAIL_SERVICE_PORT=8703
MAIL_SERVICE_API_KEY=

# SMTP configuration (used only by mail-service)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=""
MAIL_SIGNATURE="Hybrid Auth Security Team"

# Internal identity status API (key generated by prepare-env.sh)
IDENTITY_SERVICE_URL=http://127.0.0.1:8701
IDENTITY_SERVICE_KEY=
USER_DB_URL=jdbc:postgresql://127.0.0.1:5432/userdb
USER_DB_USERNAME=profiles_app
PROFILE_DB_PASSWORD=profiledev

# Gateway-to-Auth client IP signatures (generated by prepare-env.sh when empty)
AUTH_PROXY_KEY=
# Private JWK manifest (prepare-jwt.sh initializes it from existing PEMs when empty)
JWT_KEY_SET=
LOGIN_IP_LIMIT=20
AUTH_IP_LIMIT=60
AUTH_RATE_WINDOW_SECONDS=60
LOGIN_FAILURE_THRESHOLD=5
LOGIN_OBSERVATION_SECONDS=900
LOGIN_LOCK_SECONDS=300

# Public origin used in password reset and email confirmation links. Use HTTPS outside localhost.
ACCOUNT_PUBLIC_BASE_URL=http://localhost:8700

# Gateway hostnames and frontend origins (comma-separated exact values)
GATEWAY_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
GATEWAY_REQUIRE_ORIGIN=false

# Exact numeric ingress proxy IPs; empty trusts no forwarded client IP.
GATEWAY_TRUSTED_PROXIES=

# Local centralized audit collection started by run-services.sh.
AUDIT_COLLECTOR_ENABLED=true
AUDIT_COLLECTOR_PORT=8710

# User service internal API, also used by Auth export/deletion jobs.
USER_URL=http://127.0.0.1:8702

# P5: optional local observability stack (compose.observability.yaml).
# Set true before starting the Java services when the Collector is running.
OBSERVABILITY_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://127.0.0.1:4318/v1/metrics
METRICS_EXPORT_STEP=15s
TRACING_SAMPLE_PROBABILITY=1.0
DEPLOYMENT_ENVIRONMENT=local
# Set a unique SERVICE_INSTANCE_ID per JVM when deploying multiple hosts/instances.
TELEMETRY_LOG_PATH=logs/telemetry
# Required to launch Grafana; choose your own password. Default user: admin.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3001
